object cmd extends Module {

  trait Shared extends PlatformScalaModule {
    def scalaVersion = Versions.scala
    def repositories = Seq("https://central.sonatype.com/repository/maven-snapshots/")
    def mvnDeps = Seq(
      Deps.decline,
      Deps.`woof-core`,
    )
  }

  object jvm extends Shared {
    def moduleDeps = Seq(bittorrent.jvm, dht.jvm, files.jvm)
  }

  object native extends Shared, CommixGC {
    def scalaNativeVersion = Versions.scalaNative
    def moduleDeps = Seq(bittorrent.native, dht.native, files.native)
  }

  object nativeStatic extends Shared, CommixGC {
    def scalaNativeVersion = Versions.scalaNative
    def moduleDeps = Seq(bittorrent.native, dht.native, files.native)
    override def nativeClang: T[PathRef] = Task {
      sys.env.get("MUSL_CLANG") match {
        case Some(p) => PathRef(os.Path(p))
        case None    => super.nativeClang()
      }
    }
    override def nativeClangPP: T[PathRef] = Task {
      sys.env.get("MUSL_CLANGPP") match {
        case Some(p) => PathRef(os.Path(p))
        case None    => super.nativeClangPP()
      }
    }
    override def nativeLinkingOptions: T[Seq[String]] = Task {
      super.nativeLinkingOptions() ++ Seq("-static")
    }
    // Belt-and-braces: never let zig cc inject UBSan into the static binary,
    // even if the release mode is overridden back to debug somewhere.
    override def nativeCompileOptions: T[Seq[String]] = Task {
      super.nativeCompileOptions() ++ Seq("-fno-sanitize=undefined")
    }
  }
}

